{
  "name": "@quanzaiyu/dsh-creative-studio",
  "version": "1.0.0",
  "type": "module",
  "description": "创作展示台 — DSH 多供应商 AI 创作工作台：生图 / 生视频 / 音乐 / 配音，支持参考图/视频/音频与自定义供应商模型 (Multi-provider AI creative studio plugin for DeepSeek Harness)",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/**",
    "web/**",
    "cordis.patch.yml",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "ai",
    "image-generation",
    "video-generation",
    "music-generation",
    "tts",
    "creative-studio",
    "moss",
    "minimax",
    "dashscope",
    "volcengine",
    "agnes"
  ],
  "license": "MIT",
  "author": "quanzaiyu",
  "repository": "https://cnb.cool/quanzaiyu/quanzaiyu/creative-studio",
  "homepage": "https://cnb.cool/quanzaiyu/quanzaiyu/creative-studio",
  "bugs": "https://cnb.cool/quanzaiyu/quanzaiyu/creative-studio/issues"
}
